NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://localhost:27017/roomhy
JWT_SECRET=your_jwt_secret_key_here

# PayU Payment Gateway Configuration
# Localhost / Testing: PAYU_ENV=sandbox
# Production: PAYU_ENV=production
PAYU_ENV=sandbox
PAYU_MERCHANT_KEY=YOUR_PAYU_MERCHANT_KEY
PAYU_MERCHANT_SALT=YOUR_PAYU_MERCHANT_SALT
PAYU_SUCCESS_URL=http://localhost:5001/api/payments/payu/response
PAYU_FAILURE_URL=http://localhost:5001/api/payments/payu/response

# Application URLs
API_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
FROM_EMAIL=noreply@example.com
FROM_NAME=RoomHy
