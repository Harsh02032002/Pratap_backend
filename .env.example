NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://localhost:27017/roomhy
JWT_SECRET=your_jwt_secret_key_here

# PayU Payment Gateway Configuration
# Localhost / Testing: PAYU_ENV=sandbox
# Production: PAYU_ENV=production
PAYU_ENV=production
PAYU_MERCHANT_KEY=YOUR_PAYU_LIVE_MERCHANT_KEY
PAYU_MERCHANT_SALT=YOUR_PAYU_LIVE_MERCHANT_SALT
PAYU_SUCCESS_URL=https://api.roomhy.com/api/payments/payu/response
PAYU_FAILURE_URL=https://api.roomhy.com/api/payments/payu/response

# Application URLs
API_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
FROM_EMAIL=noreply@example.com
FROM_NAME=RoomHy

# Redis (one shared instance; see config/redis.js). Both switches default to false.
# rediss:// enables TLS. Never commit a real URL — it contains the password.
REDIS_URL=
# Disposable read cache (staff visit-scope, SA report overviews). false = MongoDB only.
CACHE_ENABLED=false
# Bump (v1 -> v2) to orphan all cache entries after a cache-shape change.
CACHE_VERSION=v1
# Optional allow-list for gradual rollout, e.g. sa-reports-overview,visit-scope,sa-home-overview,owner-demand
CACHE_RESOURCES=
# OTP + rate-limit counters shared across processes. false = per-process memory.
REDIS_STATE_ENABLED=false
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=500
CACHE_MAX_PAYLOAD_BYTES=524288
# Bearer token Prometheus must send to GET /metrics (16+ chars). Unset = /metrics is 404.
METRICS_TOKEN=
